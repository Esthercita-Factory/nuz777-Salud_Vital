@model Mascota
@{
    ViewData["Title"] = $"Ficha de {Model.Nombre}";
    var especie = (Model.Especie ?? "").ToLowerInvariant();
    var claseBanner = especie switch
    {
        "perro" => "sv-cabeza-perro",
        "gato" => "sv-cabeza-gato",
        "conejo" => "sv-cabeza-conejo",
        "loro" => "sv-cabeza-loro",
        _ => ""
    };
    var sexo = Model.Sexo == Sexo.Macho ? "Macho" : "Hembra";
    var meses = Model.EdadEnMeses;
    var anios = meses / 12;
    var mesesResto = meses % 12;
    var edadLegible = anios > 0
        ? $"{anios} año{(anios != 1 ? "s" : "")}{(mesesResto > 0 ? $" {mesesResto} m" : "")}"
        : $"{meses} meses";
}

<div class="sv-detalles">
    <div class="sv-detalles-topbar">
        <a class="sv-detalles-back" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Catálogo
        </a>
    </div>

    <div class="sv-detalles-banner @claseBanner">
        <div class="sv-detalles-banner-overlay">
            <div class="sv-detalles-banner-body">
                <div class="sv-detalles-banner-text">
                    <h1 class="sv-detalles-pet-name">@Model.Nombre</h1>
                    <p class="sv-detalles-pet-meta">@Model.Especie · @Model.Raza · @sexo · @edadLegible</p>
                </div>
                <div class="sv-detalles-banner-actions">
                    <a class="sv-detalles-btn sv-detalles-btn-primary" asp-controller="Consultas" asp-action="Crear" asp-route-mascotaId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        Nueva consulta
                    </a>
                    <a class="sv-detalles-btn sv-detalles-btn-ghost" asp-action="Editar" asp-route-id="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        Editar
                    </a>
                    <button type="button" class="sv-detalles-btn sv-detalles-btn-danger"
                            data-eliminar
                            data-url="@Url.Action(nameof(MascotasController.ConfirmarEliminar), "Mascotas", new { id = Model.Id })"
                            data-mensaje="Se eliminará a @Model.Nombre junto con sus @(Model.Consultas.Count) consulta(s). Esta acción no se puede deshacer.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 15H6L5 6M10 11v6M14 11v6"/></svg>
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <section class="sv-detalles-section">
        <h2 class="sv-detalles-section-title">Información general</h2>
        <div class="sv-detalles-info-grid">
            <div class="sv-detalles-tile">
                <dt class="sv-detalles-tile-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Estado
                </dt>
                <dd class="sv-detalles-tile-value">
                    <span class="sv-detalles-status @(Model.EstaActivo ? "" : "sv-detalles-status--off")">
                        <span class="sv-detalles-status-dot"></span>
                        @(Model.EstaActivo ? "Activo" : "Inactivo")
                    </span>
                </dd>
            </div>
            <div class="sv-detalles-tile">
                <dt class="sv-detalles-tile-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Edad
                </dt>
                <dd class="sv-detalles-tile-value">@edadLegible</dd>
            </div>
            <div class="sv-detalles-tile">
                <dt class="sv-detalles-tile-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6.5 6.5h11M6.5 17.5h11M4 10h16M4 14h16"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                    Peso
                </dt>
                <dd class="sv-detalles-tile-value">@Model.PesoEnKg.ToString("0.##") kg</dd>
            </div>
            <div class="sv-detalles-tile">
                <dt class="sv-detalles-tile-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Dueño
                </dt>
                <dd class="sv-detalles-tile-value">@Model.NombreDelDuenio</dd>
            </div>
            <div class="sv-detalles-tile">
                <dt class="sv-detalles-tile-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    Teléfono
                </dt>
                <dd class="sv-detalles-tile-value">@Model.TelefonoDelDuenio</dd>
            </div>
            <div class="sv-detalles-tile">
                <dt class="sv-detalles-tile-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Notas
                </dt>
                <dd class="sv-detalles-tile-value">@(string.IsNullOrWhiteSpace(Model.Notas) ? "—" : Model.Notas)</dd>
            </div>
        </div>
    </section>

    <div class="sv-detalles-pulse-banner" aria-hidden="true">
        <div class="sv-detalles-pulse-content">
            <div class="sv-detalles-pulse-text">
                <span class="sv-detalles-pulse-kicker">Signos vitales</span>
                <p class="sv-detalles-pulse-phrase">Cada latido cuenta la historia de @Model.Nombre.</p>
            </div>
            <div class="sv-detalles-pulse-ekg">
                <svg viewBox="0 0 500 80" preserveAspectRatio="none">
                    <path class="sv-detalles-pulse-line" d="M0,40 L80,40 L105,15 L125,65 L145,10 L165,55 L185,40 L280,40 L305,20 L325,60 L345,5 L365,50 L385,40 L500,40" />
                    <circle class="sv-detalles-pulse-dot" cx="145" cy="10" r="3" />
                </svg>
            </div>
        </div>
    </div>

    <section class="sv-detalles-section">
        <div class="sv-detalles-section-header">
            <h2 class="sv-detalles-section-title">Historial de consultas <span class="sv-detalles-count">@Model.Consultas.Count</span></h2>
            <a class="sv-detalles-btn sv-detalles-btn-primary sv-detalles-btn-sm" asp-controller="Consultas" asp-action="Crear" asp-route-mascotaId="@Model.Id">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Nueva consulta
            </a>
        </div>

        @if (Model.Consultas.Count == 0)
        {
            <div class="sv-detalles-empty">
                <div class="sv-detalles-empty-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <p>Sin consultas registradas</p>
            </div>
        }
        else
        {
            <div class="sv-detalles-timeline">
                @foreach (var c in Model.Consultas.OrderByDescending(c => c.Fecha))
                {
                    <article class="sv-detalles-consulta">
                        <header class="sv-detalles-consulta-head">
                            <div class="sv-detalles-consulta-meta">
                                <time class="sv-detalles-consulta-date">@c.Fecha.ToString("dd/MM/yyyy")</time>
                                <span class="sv-detalles-consulta-motivo">@c.Motivo</span>
                            </div>
                            <div class="sv-detalles-consulta-actions">
                                <button class="sv-detalles-icon-btn" onclick="location.href='@Url.Action(nameof(ConsultasController.Editar), "Consultas", new { id = c.Id })'" title="Editar" aria-label="Editar consulta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                </button>
                                <button class="sv-detalles-icon-btn sv-detalles-icon-btn--danger"
                                        data-eliminar
                                        data-url="@Url.Action(nameof(ConsultasController.ConfirmarEliminar), "Consultas", new { id = c.Id })"
                                        data-mensaje="Se eliminará la consulta del @c.Fecha.ToString("dd/MM/yyyy") (@c.Motivo). Esta acción no se puede deshacer."
                                        title="Eliminar" aria-label="Eliminar consulta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                </button>
                            </div>
                        </header>
                        <div class="sv-detalles-consulta-fields">
                            <div class="sv-detalles-consulta-field">
                                <span class="sv-detalles-consulta-field-label">Síntomas</span>
                                <span class="sv-detalles-consulta-field-value">@(string.IsNullOrWhiteSpace(c.Sintomas) ? "—" : c.Sintomas)</span>
                            </div>
                            <div class="sv-detalles-consulta-field">
                                <span class="sv-detalles-consulta-field-label">Diagnóstico</span>
                                <span class="sv-detalles-consulta-field-value">@(string.IsNullOrWhiteSpace(c.Diagnostico) ? "—" : c.Diagnostico)</span>
                            </div>
                            <div class="sv-detalles-consulta-field">
                                <span class="sv-detalles-consulta-field-label">Tratamiento</span>
                                <span class="sv-detalles-consulta-field-value">@(string.IsNullOrWhiteSpace(c.Tratamiento) ? "—" : c.Tratamiento)</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<partial name="_ModalEliminar" />
